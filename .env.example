# ==============================================================================
# BlueShore Technologies - Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' in local development and populate sensitive keys.
# NEVER commit the actual '.env' file to source control.

# ------------------------------------------------------------------------------
# Core Django Configuration
# ------------------------------------------------------------------------------
# Set DJANGO_DEBUG=False in production.
DJANGO_DEBUG=True

# Generate a strong, unique secret key for production environments.
DJANGO_SECRET_KEY=your-django-secret-key-here-min-50-chars

# Comma-separated list of allowed hostnames/IPs.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,www.blueshoretech.com

# ------------------------------------------------------------------------------
# Database Setup (PostgreSQL Primary / SQLite Fallback)
# ------------------------------------------------------------------------------
# Set USE_POSTGRES=True for production PostgreSQL containers.
USE_POSTGRES=False
DB_NAME=blueshore_db
DB_USER=blueshore_admin
DB_PASSWORD=your-secure-postgres-password-here
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------------------------
# Redis & Celery Task Queue Setup
# ------------------------------------------------------------------------------
# Set USE_REDIS=True when Redis container is running.
USE_REDIS=False
REDIS_URL=redis://:your-redis-password@127.0.0.1:6379/1
CELERY_BROKER_URL=redis://:your-redis-password@127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://:your-redis-password@127.0.0.1:6379/0
REDIS_PASSWORD=your-redis-password-here

# ------------------------------------------------------------------------------
# AWS S3 Asset Storage (Optional)
# ------------------------------------------------------------------------------
USE_AWS_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ------------------------------------------------------------------------------
# Third-Party AI API Keys
# ------------------------------------------------------------------------------
# Google Gemini API Key for AI Chatbot Rep
GEMINI_API_KEY=your-google-gemini-api-key-here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# ClamAV Antivirus Scanner (Resume Scanning)
# ------------------------------------------------------------------------------
CLAMAV_ENABLED=False
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ------------------------------------------------------------------------------
# Production Security & SSL Settings
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.blueshoretech.com,https://blueshoretech.com
